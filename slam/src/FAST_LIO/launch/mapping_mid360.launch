<launch>
<!-- Launch file for Livox MID360 LiDAR -->

		<arg name="rviz" default="true" />
		<arg name="rviz_config" default="$(find fast_lio)/rviz_cfg/mapping_tum.rviz" />
		<arg name="start_lidar" default="true" />
		<arg name="pcd_save_path" default="$(find fast_lio)/PCD/scans.pcd" />
		<arg name="tum_path" default="" />
		<arg name="odom_topic" default="/Odometry" />
	<group if="$(arg start_lidar)">
    <include file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360s.launch">
      <arg name="xfer_format" value="1"/>
    </include>
    </group>

		<rosparam command="load" file="$(find fast_lio)/config/mid360.yaml" />
		<param name="pcd_save/path" type="string" value="$(arg pcd_save_path)" />
		<param name="publish/path_en" type="bool" value="true" />
		<param name="publish/dense_publish_en" type="bool" value="false" />

	<param name="feature_extract_enable" type="bool" value="0"/>
	<param name="point_filter_num" type="int" value="3"/>
	<param name="max_iteration" type="int" value="3" />
	<param name="filter_size_surf" type="double" value="0.5" />
	<param name="filter_size_map" type="double" value="0.5" />
	<param name="cube_side_length" type="double" value="1000" />
	<param name="runtime_pos_log_enable" type="bool" value="0" />
    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" /> 
	<node if="$(eval arg('tum_path') != '')" pkg="fast_lio" type="record_tum.py" name="fastlio_tum_recorder" output="screen">
		<param name="output" value="$(arg tum_path)"/>
		<param name="odom_topic" value="$(arg odom_topic)"/>
	</node>

	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(arg rviz_config)" />
	</group>

</launch>
