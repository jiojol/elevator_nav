<?xml version="1.0"?>
<launch>
  <arg name="map_set" default="yuki"/>
  <arg name="map_prefix" value="$(eval {'yuki': 'yuki/dog', 'test11': 'test11/test11'}[arg('map_set')])"/>
  <arg name="globalmap_pcd" default="$(find dog_nav_bringup)/../../../system/map/$(arg map_prefix).pcd"/>
  <arg name="plan_meta" default="$(find dog_nav_bringup)/../../../system/map/$(arg map_prefix)_plan.json"/>
  <arg name="start_lidar" default="true"/>
  <arg name="record_nav" default="false"/>
  <arg name="nav_bag" default=""/>
  <arg name="start_lio" default="true"/>
  <arg name="lio_config" default="root_config.yaml"/>
  <arg name="start_bridge" default="true"/>
  <arg name="planning_only" default="$(eval arg('map_set') == 'test11')"/>
  <arg name="planning_live_pose" default="$(eval arg('map_set') == 'test11')"/>
  <arg name="manual_start" value="$(eval arg('planning_only') and not arg('planning_live_pose'))"/>
  <arg name="use_calibrated_mount" default="false"/>
  <arg name="start_rviz" default="true"/>
  <arg name="rviz_config" default="$(find dog_nav_bringup)/config/navigation_free.rviz"/>
  <arg name="scan_max_vel" default="$(eval 0.75 if arg('map_set') == 'test11' else 0.20)"/>
  <arg name="elevator_speed_limit" default="0.20"/>
  <arg name="elevator_ingress_speed_limit" default="$(arg scan_max_vel)"/>
  <arg name="scan_max_acc" default="0.50"/>
  <arg name="scan_max_lateral" default="$(eval 0.35 if arg('map_set') == 'test11' else 0.10)"/>
  <arg name="scan_max_yaw" default="$(eval 1.00 if arg('map_set') == 'test11' else 0.30)"/>
  <arg name="scan_body_height" default="0.40"/>
  <arg name="scan_path_z_offset" default="0.0"/>
  <arg name="map_config_suffix" value="$(eval '_test11' if arg('plan_meta').endswith('/test11_plan.json') else '_yuki' if arg('plan_meta').endswith('system/map/yuki/dog_plan.json') else '')"/>
  <arg name="floors_config" default="$(find dog_nav_bringup)/config/floors$(arg map_config_suffix).yaml"/>
  <arg name="elevator_config" default="$(find dog_nav_bringup)/config/elevator$(arg map_config_suffix).yaml"/>

  <node pkg="rosbag" type="record" name="elevator_nav_recorder" output="screen"
        if="$(arg record_nav)"
        args='--split --size=2048 -O "$(arg nav_bag)"
              /livox/lidar /livox/imu /tf /tf_static /rosout
              /LIO/odom_imu /LIO/in_elevator /dog_nav/odometry /dog_nav/localization_status
              /dog_nav/sensor_pose /navigation/obstacle_points /initialpose /move_base_simple/goal
              /elevator_nav/status /elevator_nav/result /elevator/door_open /elevator/door_status
              /plan_map/segment_goal /plan_map/global_path /initial_path /map_manager/status /map_manager/result
              /planning/bspline /planning/go2_execution_frozen /planning/go2_execution_progress
              /planning/scan_upstream_cmd_vel /planning/upstream_adapter_status /planning/goal_reached
              /cmd_vel /go2/odom /go2_ros_bridge/control_status'/>

  <node pkg="lio" type="lio" name="lio" output="screen" required="true"
        if="$(eval arg('start_lio') and not arg('manual_start'))">
    <param name="config_path" value="$(arg lio_config)" type="str"/>
  </node>

  <node pkg="dog_nav_bringup" type="unitree_nav_bridge" name="go2_ros_bridge"
        output="screen" required="true" if="$(eval arg('start_bridge') and not arg('planning_only'))">
    <rosparam command="load" file="$(find dog_nav_bringup)/config/unitree_bridge.yaml"/>
    <param name="max_linear_x" value="$(arg scan_max_vel)" type="double"/>
    <param name="max_linear_y" value="$(arg scan_max_lateral)" type="double"/>
    <param name="max_angular_z" value="$(arg scan_max_yaw)" type="double"/>
  </node>

  <include file="$(find dog_nav_bringup)/launch/elevator_lio_localization.launch">
    <arg name="globalmap_pcd" value="$(arg globalmap_pcd)"/>
    <arg name="start_lidar" value="$(eval arg('start_lidar') and not arg('manual_start'))"/>
    <arg name="map_only" value="$(arg manual_start)"/>
    <arg name="use_calibrated_mount" value="$(arg use_calibrated_mount)"/>
  </include>

  <include file="$(find dog_nav_bringup)/launch/scan_upstream.launch"
           unless="$(arg planning_only)">
    <arg name="max_vel" value="$(arg scan_max_vel)"/>
    <arg name="elevator_config" value="$(arg elevator_config)"/>
    <arg name="elevator_speed_limit" value="$(arg elevator_speed_limit)"/>
    <arg name="elevator_ingress_speed_limit" value="$(arg elevator_ingress_speed_limit)"/>
    <arg name="max_acc" value="$(arg scan_max_acc)"/>
    <arg name="max_lateral" value="$(arg scan_max_lateral)"/>
    <arg name="max_yaw" value="$(arg scan_max_yaw)"/>
    <arg name="body_height" value="$(arg scan_body_height)"/>
    <arg name="path_z_offset" value="$(arg scan_path_z_offset)"/>
  </include>

  <include file="$(find map_for_plan)/launch/plan.launch">
    <arg name="meta" value="$(arg plan_meta)"/>
    <arg name="floors_config" value="$(arg floors_config)"/>
    <arg name="elevator_config" value="$(arg elevator_config)"/>
    <arg name="body_height" value="$(arg scan_body_height)"/>
    <arg name="path_z_offset" value="$(arg scan_path_z_offset)"/>
    <arg name="mission_segment_only" value="true"/>
    <arg name="planning_only" value="$(arg planning_only)"/>
    <arg name="manual_start" value="$(arg manual_start)"/>
    <arg name="local_planner" value="upstream"/>
  </include>

  <node pkg="dog_nav_bringup" type="elevator_mission_manager.py"
        name="elevator_mission_manager" output="screen" required="true">
    <rosparam command="load" file="$(arg floors_config)"/>
    <rosparam command="load" file="$(arg elevator_config)"/>
    <rosparam command="load" file="$(find dog_nav_bringup)/config/elevator_mission.yaml"/>
    <param name="manual_start" value="$(arg manual_start)" type="bool"/>
    <param name="preview_routes" value="$(arg planning_only)" type="bool"/>
    <param name="body_height" value="$(arg scan_body_height)" type="double"/>
  </node>

  <node pkg="dog_nav_bringup" type="elevator_door_monitor.py"
        name="elevator_door_monitor" output="screen" required="true" unless="$(arg manual_start)">
    <rosparam command="load" file="$(arg floors_config)"/>
    <rosparam command="load" file="$(arg elevator_config)"/>
    <rosparam command="load" file="$(find dog_nav_bringup)/config/elevator_door_monitor.yaml"/>
    <param name="body_height" value="$(arg scan_body_height)" type="double"/>
  </node>

  <include file="$(find dog_nav_bringup)/launch/visualization.launch" if="$(arg start_rviz)">
    <arg name="rviz_config" value="$(arg rviz_config)"/>
  </include>
</launch>
