<?xml version="1.0"?>
<package format="2">
  <name>map_for_plan</name>
  <version>0.1.0</version>
  <description>TUM trajectory based 3D free-space map and global planner.</description>
  <maintainer email="maintainer@example.com">dog_nav_3d</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>scan_planner</exec_depend>
</package>
